{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-definition.schema.json",
  "title": "Gates V2 Gate Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_notice",
    "gate_id",
    "order",
    "slug",
    "definition_version",
    "locale",
    "lifecycle",
    "language",
    "symbolism",
    "identity_statements",
    "reflections",
    "journals",
    "observation_markers",
    "habit_markers",
    "growth_signals",
    "integration_signals",
    "self_correction_signals",
    "family_practice_refs",
    "developmental_tool_refs",
    "ceremony_refs",
    "age_band_variants",
    "media_refs",
    "source_provenance",
    "approvals"
  ],
  "properties": {
    "schema_version": {
      "const": "gate-definition.v1"
    },
    "content_notice": {
      "type": "string",
      "minLength": 1
    },
    "gate_id": {
      "enum": [
        "gate_attention",
        "gate_emotion",
        "gate_choice",
        "gate_body",
        "gate_discipline",
        "gate_truth",
        "gate_repair",
        "gate_creation",
        "gate_community",
        "gate_legacy"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z]+$"
    },
    "definition_version": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}-[A-Z]{2}$"
    },
    "lifecycle": {
      "enum": [
        "draft",
        "imported",
        "under_review",
        "approved",
        "published",
        "retired"
      ]
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "core_statement",
        "philosophy",
        "developmental_purpose",
        "child",
        "parent"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "core_statement": {
          "type": "string",
          "minLength": 1
        },
        "philosophy": {
          "type": "string",
          "minLength": 1
        },
        "developmental_purpose": {
          "type": "string",
          "minLength": 1
        },
        "child": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "symbolism": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol_id",
          "label",
          "meaning"
        ],
        "properties": {
          "symbol_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "identity_statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id"
        ],
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "reflections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id"
        ],
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "journals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id"
        ],
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "observation_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marker_id",
          "description"
        ],
        "properties": {
          "marker_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "habit_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marker_id",
          "description"
        ],
        "properties": {
          "marker_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "growth_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marker_id",
          "description"
        ],
        "properties": {
          "marker_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "integration_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marker_id",
          "description"
        ],
        "properties": {
          "marker_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "self_correction_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marker_id",
          "description"
        ],
        "properties": {
          "marker_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "family_practice_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "developmental_tool_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ceremony_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "age_band_variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k1",
        "g2_3",
        "g4"
      ],
      "properties": {
        "k1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref_id"
          ],
          "properties": {
            "ref_id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "g2_3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref_id"
          ],
          "properties": {
            "ref_id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "g4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref_id"
          ],
          "properties": {
            "ref_id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "source_version",
          "relationship",
          "canonicality",
          "verification_status"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "enum": [
              "canonical_book",
              "orin_chapter",
              "approved_statement",
              "author_note",
              "v1_import",
              "new_child_content",
              "review_record"
            ]
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "chapter": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            }
          },
          "relationship": {
            "enum": [
              "quotes",
              "adapts",
              "echoes",
              "informed_by",
              "unresolved"
            ]
          },
          "canonicality": {
            "enum": [
              "canonical",
              "supporting",
              "non_canonical",
              "unknown"
            ]
          },
          "verification_status": {
            "enum": [
              "unverified",
              "verified",
              "disputed"
            ]
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_type",
          "reviewer_id",
          "decision",
          "reviewed_version_hash",
          "decided_at"
        ],
        "properties": {
          "review_type": {
            "enum": [
              "author",
              "philosophy",
              "developmental",
              "cultural",
              "safety",
              "technical"
            ]
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 2
          },
          "decision": {
            "enum": [
              "approved",
              "changes_requested",
              "rejected"
            ]
          },
          "reviewed_version_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
